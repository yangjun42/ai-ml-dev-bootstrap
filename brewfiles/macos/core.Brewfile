# Core macOS development host.
# macOS + Apple Command Line Tools provide Git and OpenSSH, so they are
# intentionally not reinstalled through Homebrew.

# Remote development and repository workflow.
brew "tmux"
brew "gh"
brew "git-lfs"
brew "uv"
brew "btop"

# Small, mainstream terminal productivity stack.
brew "starship"
brew "zoxide"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "jq"
brew "yq"
brew "bat"
brew "shellcheck"
brew "just"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Primary terminal and editor. VS Code extensions remain user-managed.
cask "ghostty"
cask "visual-studio-code"
