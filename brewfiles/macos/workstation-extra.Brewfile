# Optional native-build and Docker-compatible workstation additions.
# This file is layered on top of minimal.Brewfile and developer-extra.Brewfile.
# It installs tooling only; it does not start Colima or create containers.

brew "cmake"
brew "ninja"
brew "pkgconf"
brew "ffmpeg"
brew "colima"
brew "docker"
brew "docker-compose"
