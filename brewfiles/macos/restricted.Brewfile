# Conservative host-only profile for machines where public AI services and
# local model runtimes require separate approval.
# Git and OpenSSH continue to come from macOS + Apple Command Line Tools.
# macOS native window tiling is used instead of a third-party window manager.

brew "tmux"
brew "gh"
brew "git-lfs"
brew "uv"
brew "btop"

cask "ghostty"
cask "visual-studio-code"
