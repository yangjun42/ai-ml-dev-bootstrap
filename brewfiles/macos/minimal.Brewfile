# Core/minimal Mac profile.
# macOS + Apple Command Line Tools provide Git and OpenSSH, so they are
# intentionally not reinstalled through Homebrew.

brew "tmux"
brew "gh"
brew "git-lfs"
brew "uv"
brew "btop"

cask "ghostty"
cask "visual-studio-code"
cask "chatgpt"
cask "claude-code"
cask "ollama-app"
cask "rectangle"
