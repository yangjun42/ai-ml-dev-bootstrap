# Optional additions for developers who want a polished interactive shell and
# common CLI conveniences. This file is layered on top of minimal.Brewfile.

# Prompt, navigation, fuzzy search, and lightweight zsh enhancements.
brew "starship"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Repository and data-oriented CLI tools.
brew "ripgrep"
brew "fd"
brew "fzf"
brew "jq"
brew "yq"
brew "bat"
brew "shellcheck"
brew "just"
